<PersonCard Class="mb-4" />

<div class="app-sidebar__nav">
    <div class="nav-search" role="search">
        <i class="fas fa-search nav-search__icon" aria-hidden="true"></i>
        <input
            class="nav-search__input"
            type="search"
            placeholder="搜索菜单 / 拼音"
            aria-label="搜索菜单"
            @bind="_searchText"
            @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(_searchText))
        {
            <button class="nav-search__clear" type="button" title="清空搜索" @onclick="ClearSearch">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        }
    </div>

    @foreach (var group in FilteredGroups)
    {
        var isExpanded = IsGroupExpanded(group);
        var groupContentId = $"nav-group-{group.Key}";
        <section class="nav-group">
            <button
                id="@(groupContentId)-title"
                class="nav-group__title"
                type="button"
                aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                aria-controls="@groupContentId"
                aria-label="@GetGroupToggleLabel(group, isExpanded)"
                title="@GetGroupToggleLabel(group, isExpanded)"
                disabled="@IsSearchActive"
                @onclick="() => ToggleGroupAsync(group.Key)">
                <span>@group.Title</span>
                <i
                    class="fas fa-chevron-down nav-group__chevron @(isExpanded ? "is-expanded" : "")"
                    aria-hidden="true"></i>
            </button>
            <div
                id="@groupContentId"
                class="nav-group__items"
                aria-labelledby="@(groupContentId)-title"
                hidden="@(!isExpanded)">
                @foreach (var item in group.Items)
                {
                    <NavLink href="@item.Href" Match="@item.Match" Class="nav-item">
                        <i class="@item.Icon" aria-hidden="true"></i>
                        <span>@item.Label</span>
                    </NavLink>
                }
            </div>
        </section>
    }

    @if (!FilteredGroups.Any())
    {
        <div class="nav-search__empty">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            <span>没有匹配的菜单</span>
        </div>
    }
</div>
