@page "/seo"
@page "/seo/list"
@attribute [Authorize]

<div class="seo-workbench">
    <div class="seo-workbench__header">
        <div>
            <h1 class="page-title">
                <i class="fas fa-search"></i>
                SEO 管理
            </h1>
            <p class="page-description">按已扫描 MVC 路由配置页面元数据和公共继承规则</p>
        </div>
        <div class="seo-workbench__header-actions">
            <button class="btn btn-secondary" @onclick="RefreshCacheAsync" disabled="@_isLoading">
                <i class="fas fa-sync-alt"></i>
                刷新缓存
            </button>
            <button class="btn-icon" title="刷新列表" @onclick="ReloadAsync" disabled="@_isLoading">
                <i class="fas fa-redo-alt @(_isLoading ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>

    <div class="seo-overview">
        <section class="seo-public-panel">
            <div class="seo-panel__heading">
                <div>
                    <div class="seo-panel__eyebrow">Public Metadata</div>
                    <h2>公共 SEO</h2>
                </div>
                <button class="btn btn-primary btn-sm" @onclick="EditPublicAsync" disabled="@_isLoading">
                    <i class="fas fa-pen"></i>
                    @(_publicMetadata == null ? "配置公共 SEO" : "编辑公共 SEO")
                </button>
            </div>

            @if (_publicMetadata == null)
            {
                <div class="seo-public-panel__empty">
                    <i class="fas fa-layer-group"></i>
                    <span>尚未配置公共元数据</span>
                </div>
            }
            else
            {
                <div class="seo-public-panel__body">
                    <div>
                        <span class="seo-status @GetInheritanceClass(_publicMetadata)">
                            @GetInheritanceLabel(_publicMetadata)
                        </span>
                    </div>
                    <div class="seo-public-panel__title" title="@_publicMetadata.Title">
                        @Clip(_publicMetadata.Title, 72)
                    </div>
                    <div class="seo-public-panel__description" title="@_publicMetadata.Description">
                        @Clip(_publicMetadata.Description, 130)
                    </div>
                    <div class="seo-public-panel__keywords">
                        @foreach (var keyword in _publicMetadata.Keywords.Take(6))
                        {
                            <span class="seo-chip">@keyword</span>
                        }
                        @if (_publicMetadata.Keywords.Count == 0)
                        {
                            <span class="seo-table__empty">无公共关键词</span>
                        }
                    </div>
                </div>
            }
        </section>

        <section class="seo-route-panel">
            <div class="seo-panel__heading">
                <div>
                    <div class="seo-panel__eyebrow">Route Catalog</div>
                    <h2>路由目录</h2>
                </div>
                <span class="seo-status seo-status--info">@_routes.Count 条路由</span>
            </div>
            <div class="seo-route-panel__stats">
                <div>
                    <span>@_routes.Count</span>
                    <label>可配置页面</label>
                </div>
                <div>
                    <span>@RouteParameterCount</span>
                    <label>允许参数</label>
                </div>
                <div>
                    <span>@_items.Count</span>
                    <label>当前配置</label>
                </div>
            </div>
            @if (_routes.Count == 0 && !_isLoading)
            {
                <div class="seo-route-panel__empty">暂无已扫描路由</div>
            }
            else
            {
                <div class="seo-route-panel__samples">
                    @foreach (var route in _routes.Take(3))
                    {
                        <div class="seo-route-sample">
                            <span>@FormatRoute(route)</span>
                            <small>@string.Join(", ", route.HttpMethods)</small>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <div class="seo-list__toolbar">
        <div class="seo-list__toolbar-left">
            <button class="btn btn-primary" @onclick="AddAsync" disabled="@(_isLoading || _routes.Count == 0)">
                <i class="fas fa-plus"></i>
                新增页面 SEO
            </button>
            <div class="seo-list__summary">
                <span class="seo-list__summary-label">共</span>
                <span class="seo-list__summary-value">@_totalCount</span>
                <span class="seo-list__summary-label">条页面配置</span>
            </div>
        </div>

        <div class="seo-list__toolbar-right">
            <div class="seo-list__search">
                <input type="text"
                       class="form-control"
                       placeholder="搜索路由、标题或描述..."
                       @bind="_searchText"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown" />
                <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_isLoading">
                    <i class="fas fa-search"></i>
                    搜索
                </button>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="seo-list-skeleton">
            <div class="seo-list-skeleton__table">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="seo-list-skeleton__row">
                        <div class="skeleton skeleton--text-lg"></div>
                        <div class="skeleton skeleton--text"></div>
                        <div class="skeleton skeleton--text"></div>
                        <div class="skeleton skeleton--text"></div>
                        <div class="skeleton skeleton--button"></div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="seo-list__empty">
            <i class="fas fa-route fa-3x"></i>
            <p>暂无页面 SEO 配置</p>
        </div>
    }
    else
    {
        <div class="seo-table">
            <div class="seo-table__wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>路由</th>
                            <th>参数</th>
                            <th>继承</th>
                            <th>页面标题</th>
                            <th>关键词</th>
                            <th>描述 / Meta</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td data-label="路由">
                                    <div class="seo-table__relation">
                                        <span class="seo-table__route">@FormatRoute(item)</span>
                                        @if (!string.IsNullOrWhiteSpace(item.RouteKey))
                                        {
                                            <span class="seo-table__route-key">@item.RouteKey</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="参数">
                                    <div class="seo-table__params">@FormatParameters(item)</div>
                                </td>
                                <td data-label="继承">
                                    <span class="seo-status @GetInheritanceClass(item)">
                                        @GetInheritanceLabel(item)
                                    </span>
                                </td>
                                <td data-label="页面标题">
                                    <div class="seo-table__title" title="@item.Title">
                                        @Clip(item.Title, 48)
                                    </div>
                                </td>
                                <td data-label="关键词">
                                    <div class="seo-table__keywords">
                                        @if (item.Keywords.Count > 0)
                                        {
                                            @foreach (var keyword in item.Keywords.Take(3))
                                            {
                                                <span class="seo-table__keyword">@keyword</span>
                                            }
                                            @if (item.Keywords.Count > 3)
                                            {
                                                <span class="seo-table__keyword-more">+@(item.Keywords.Count - 3)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="seo-table__empty">无</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="描述 / Meta">
                                    <div class="seo-table__description" title="@item.Description">
                                        @Clip(item.Description, 76)
                                    </div>
                                    <div class="seo-table__meta-count">@item.Metas.Count 个 Meta</div>
                                </td>
                                <td data-label="操作">
                                    <div class="seo-table__actions">
                                        <button class="btn btn-secondary btn-sm" @onclick="() => ViewMetasAsync(item)">
                                            <i class="fas fa-eye"></i>
                                            查看
                                        </button>
                                        <button class="btn btn-primary btn-sm" @onclick="() => EditAsync(item)">
                                            <i class="fas fa-edit"></i>
                                            编辑
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(item.Id)">
                                            <i class="fas fa-trash"></i>
                                            删除
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pagination CurrentPage="_pageIndex"
                        TotalPages="_totalPages"
                        TotalCount="_totalCount"
                        PageSize="PageSize"
                        OnPageChanged="HandlePageChanged" />
        </div>
    }
</div>
