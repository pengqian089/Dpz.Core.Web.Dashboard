@if (!string.IsNullOrEmpty(_editorId))
{
    <div class="markdown-editor-shell">
        <div id="markdown-container-@(_editorId)" class="markdown-editor-container" style="@HeightStyle">
            <div id="@_editorId"></div>
        </div>

        @if (_isUploading)
        {
            <div class="editor-loading-overlay">
                <div class="editor-loading-spinner"></div>
                <div class="editor-loading-text">正在上传图片...</div>
                <div class="editor-loading-progress">
                    <div class="editor-loading-progress-bar" style="width: @(_uploadProgress)%"></div>
                </div>
                <div class="editor-loading-progress-text">@_uploadProgress%</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_uploadError))
        {
            <div class="editor-upload-error">@_uploadError</div>
        }

        @if (ImageMode == MarkdownImageMode.Gallery)
        {
            <div class="markdown-image-panel">
                <div class="markdown-image-panel__header">
                    <div class="markdown-image-panel__title">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>图片</span>
                        <span class="markdown-image-panel__count">@_galleryImages.Count</span>
                    </div>
                    <label
                        class="markdown-image-panel__upload"
                        for="@GalleryInputId"
                        title="选择一张或多张图片上传">
                        <i class="fas fa-upload" aria-hidden="true"></i>
                        <span>上传图片</span>
                    </label>
                    <InputFile
                        @key="_inputFileKey"
                        id="@GalleryInputId"
                        class="markdown-image-panel__input"
                        multiple
                        accept="image/*"
                        OnChange="UploadGalleryImagesAsync" />
                </div>

                @if (_galleryImages.Count > 0)
                {
                    <div
                        id="@GalleryId"
                        class="markdown-image-gallery pswp-gallery"
                        aria-label="图片画廊">
                        @foreach (var image in _galleryImages)
                        {
                            var currentImage = image;
                            <figure class="markdown-image-gallery__item">
                                <img
                                    src="@currentImage.Metadata.Url"
                                    alt="@currentImage.Alt"
                                    class="markdown-image-gallery__image"
                                    loading="lazy" />
                                <button
                                    type="button"
                                    class="markdown-image-gallery__remove"
                                    title="删除图片"
                                    aria-label="删除图片"
                                    @onclick="() => RemoveGalleryImageAsync(currentImage.Metadata.Url)">
                                    <i class="fas fa-times" aria-hidden="true"></i>
                                </button>
                            </figure>
                        }
                    </div>
                }
                else
                {
                    <p class="markdown-image-panel__empty">
                        还没有图片，点击「上传图片」可一次选择多张
                    </p>
                }
            </div>
        }
    </div>
}
